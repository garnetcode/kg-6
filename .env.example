# Django Settings
# IMPORTANT: Change this in production!
SECRET_KEY='django-insecure-a-dummy-key-for-dev'
DEBUG=True

# Allowed Hosts - Add your domain in production
# e.g., ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Local Service Configuration ---

# Neo4j Database
# Ensure this URI points to your locally running Neo4j instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Ollama LLM Service
# Ensure this URL points to your locally running Ollama service.
OLLAMA_BASE_URL=http://localhost:11434

# Celery (for background tasks - not used in this version but good practice)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0